# This Vite frontend currently has no required environment variables.
# Add browser-exposed configuration with a VITE_ prefix; never put secrets here.

# VITE_API_BASE_URL=http://localhost:3000

# Server-side PostgreSQL configuration. Use these only in the backend; never
# expose database credentials through a VITE_ variable or frontend code.
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/mm_local_editor
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mm_local_editor
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
